                <button onclick="guessRiddle(1, '蘋果')" class="sketch-btn bg-[#FFFDF6] px-3 py-1.5 text-sm">🍎 蘋果</button>
                <button onclick="guessRiddle(1, '番茄')" class="sketch-btn bg-[#FFFDF6] px-3 py-1.5 text-sm">🍅 番茄</button>
