<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>115上 南一國語五上 第7、8課〈用心看世界〉互動學習與25題線上測驗</title>
  <!-- 載入 Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- 載入可愛圓體與繁體中文字體 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --paper-bg: #FFFDF6;
      --ink: #4a3525;
      --ink-soft: #7a5f4b;
      --butter: #FFF3B0;
      --mint: #D8F3DC;
      --peach: #FFD6E0;
      --sky: #D0EBFF;
      --orange: #FFE5CC;
      --lavender: #EDE4FF;
    }

    body {
      font-family: 'Zen Maru Gothic', 'Noto Sans TC', sans-serif;
      background-color: var(--paper-bg);
      color: var(--ink);
      /* 米黃色手帳點點紙背景 */
      background-image: radial-gradient(#DFD1BE 1.35px, transparent 1.35px);
      background-size: 22px 22px;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    /* 手繪繪本風卡片 */
    .sketch-card {
      background-color: #FFFFFF;
      border: 2.5px solid var(--ink);
      border-radius: 22px 18px 24px 19px / 19px 23px 18px 22px;
      box-shadow: 5px 5px 0px var(--ink);
      position: relative;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .sketch-card-hover:hover {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0px var(--ink);
    }

    /* 手繪按鈕 */
    .sketch-btn {
      border: 2.5px solid var(--ink);
      border-radius: 16px 14px 18px 15px / 15px 17px 14px 16px;
      box-shadow: 3px 3px 0px var(--ink);
      transition: all 0.14s ease;
      font-weight: 700;
      cursor: pointer;
    }

    .sketch-btn:hover:not(:disabled) {
      transform: translate(-1.5px, -1.5px);
      box-shadow: 4.5px 4.5px 0px var(--ink);
    }

    .sketch-btn:active:not(:disabled) {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px var(--ink);
    }

    .sketch-btn:disabled {
      cursor: not-allowed;
    }

    /* 半透明手繪紙膠帶裝飾 */
    .washi-tape {
      position: absolute;
      top: -13px;
      left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      width: 116px;
      height: 24px;
      opacity: 0.88;
      border-left: 2px dashed rgba(74, 53, 37, 0.28);
      border-right: 2px dashed rgba(74, 53, 37, 0.28);
      pointer-events: none;
      z-index: 10;
    }
    .washi-yellow {
      background: repeating-linear-gradient(45deg, #FFE082, #FFE082 8px, #FFF5CC 8px, #FFF5CC 16px);
    }
    .washi-pink {
      background: repeating-linear-gradient(-45deg, #FFB3C6, #FFB3C6 8px, #FFE0E9 8px, #FFE0E9 16px);
      transform: translateX(-50%) rotate(2.4deg);
    }
    .washi-mint {
      background: repeating-linear-gradient(45deg, #A7E8BD, #A7E8BD 8px, #DDF7E5 8px, #DDF7E5 16px);
      transform: translateX(-50%) rotate(-1.5deg);
    }
    .washi-sky {
      background: repeating-linear-gradient(-45deg, #99D6FF, #99D6FF 8px, #D6EEFF 8px, #D6EEFF 16px);
      transform: translateX(-50%) rotate(1.8deg);
    }

    /* 手繪輸入框 */
    .sketch-input {
      border: 2.5px solid var(--ink);
      border-radius: 14px;
      background-color: #FFFDF9;
      padding: 10px 14px;
      font-weight: 700;
      color: var(--ink);
      outline: none;
      transition: background-color 0.15s, box-shadow 0.15s;
    }
    .sketch-input:focus {
      background-color: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(255, 214, 102, 0.55);
    }

    /* 螢光筆標示（疊字詞 / 擬人法） */
    .hl-redup {
      background: linear-gradient(180deg, transparent 48%, #FFE066 48%);
      padding: 0 3px;
      border-radius: 4px;
      font-weight: 900;
    }
    .hl-person {
      background: linear-gradient(180deg, transparent 48%, #FFC2D4 48%);
      padding: 0 3px;
      border-radius: 4px;
      font-weight: 900;
    }
    .hl-mint {
      background: linear-gradient(180deg, transparent 48%, #B7E4C7 48%);
      padding: 0 3px;
      border-radius: 4px;
      font-weight: 900;
    }

    /* 導覽分頁按鈕 */
    .nav-tab {
      border: 2.5px solid var(--ink);
      border-radius: 18px 18px 14px 14px;
      box-shadow: 3px 3px 0px var(--ink);
      transition: all 0.15s ease;
    }
    .nav-tab.active {
      background-color: #FFE082;
      transform: translate(-1px, -2px);
      box-shadow: 4px 4px 0px var(--ink);
    }
    .nav-tab:not(.active) {
      background-color: #FFFFFF;
    }
    .nav-tab:not(.active):hover {
      background-color: #FFF8E1;
    }

    /* 動畫效果 */
    .fade-in {
      animation: fadeIn 0.28s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .pop-correct {
      animation: popCorrect 0.35s ease;
    }
    @keyframes popCorrect {
      0% { transform: scale(1); }
      45% { transform: scale(1.03); }
      100% { transform: scale(1); }
    }

    .shake-wrong {
      animation: shakeWrong 0.36s ease-in-out;
    }
    @keyframes shakeWrong {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-6px); }
      40% { transform: translateX(6px); }
      60% { transform: translateX(-4px); }
      80% { transform: translateX(4px); }
    }

    .float-slow {
      animation: floatSlow 3.4s ease-in-out infinite;
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }
  </style>
</head>
<body class="min-h-screen pb-14">

  <!-- 頂部浮動 Toast 提示訊息（取代 alert） -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 hidden max-w-[92vw]">
    <div id="toastInner" class="sketch-card px-5 py-3 bg-[#FFF3B0] text-[#4a3525] font-bold flex items-center gap-2 text-sm sm:text-base">
      <span id="toastIcon">✨</span>
      <span id="toastMsg">提示訊息</span>
    </div>
  </div>

  <!-- 頁首 Header -->
  <header class="max-w-5xl mx-auto px-4 pt-5 pb-3">
    <div class="sketch-card bg-gradient-to-r from-[#FFF3B0] via-[#FFFDF6] to-[#D8F3DC] p-4 sm:p-6 overflow-hidden">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <!-- 原創手繪地球與建築美食 SVG -->
          <div class="shrink-0 float-slow">
            <svg width="86" height="86" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="用心看世界手繪插圖">
              <circle cx="50" cy="52" r="40" fill="#FFE8A3" opacity="0.5"/>
              <circle cx="50" cy="58" r="30" fill="#8ECAE6" stroke="#4a3525" stroke-width="2.8"/>
              <path d="M30 50 C36 42, 47 45, 45 55 C43 62, 34 65, 28 60 Z" fill="#A7E8BD" stroke="#4a3525" stroke-width="2"/>
              <path d="M58 46 C66 44, 74 52, 72 62 C68 70, 56 68, 56 59 C56 54, 53 48, 58 46 Z" fill="#A7E8BD" stroke="#4a3525" stroke-width="2"/>
              <circle cx="42" cy="60" r="2.2" fill="#4a3525"/>
              <circle cx="58" cy="60" r="2.2" fill="#4a3525"/>
              <circle cx="38" cy="63" r="2.8" fill="#FF9EB5" opacity="0.85"/>
              <circle cx="62" cy="63" r="2.8" fill="#FF9EB5" opacity="0.85"/>
              <path d="M46 64 Q50 68 54 64" stroke="#4a3525" stroke-width="2.2" stroke-linecap="round"/>
              <!-- 迷你高第尖塔 -->
              <path d="M34 33 L39 13 L44 31 Z" fill="#FFCC80" stroke="#4a3525" stroke-width="2.2" stroke-linejoin="round"/>
              <circle cx="39" cy="11" r="3" fill="#FF758F" stroke="#4a3525" stroke-width="1.8"/>
              <!-- 迷你壽司 -->
              <rect x="57" y="19" width="20" height="11" rx="5" fill="#FFFFFF" stroke="#4a3525" stroke-width="2"/>
              <path d="M56 23 C58 17, 76 17, 78 23 Z" fill="#FF8C61" stroke="#4a3525" stroke-width="2"/>
              <!-- 星星 -->
              <path d="M18 24 L20 28 L24 30 L20 32 L18 36 L16 32 L12 30 L16 28 Z" fill="#FFD166" stroke="#4a3525" stroke-width="1.5"/>
              <circle cx="84" cy="36" r="2.5" fill="#FF758F"/>
            </svg>
          </div>
          <div>
            <div class="inline-flex flex-wrap items-center gap-1.5 px-3 py-0.5 rounded-full bg-white border-2 border-[#4a3525] text-xs sm:text-sm font-bold mb-1.5">
              <span>📚 115學年度上學期</span>
              <span>・</span>
              <span>南一版國小國語五上</span>
              <span class="px-2 py-0.2 rounded-full bg-[#FFD6E0] text-[#4a3525]">25題完整版</span>
            </div>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-black tracking-tight text-[#4a3525]">
              第參單元：用心看世界 🌍
            </h1>
            <p class="text-xs sm:text-sm font-medium text-[#7a5f4b] mt-0.5">
              第7課〈高第的魔法建築〉 × 第8課〈嘗嘗我的家鄉味〉互動學習與線上自我測驗
            </p>
          </div>
        </div>

        <!-- 學習進度小徽章 -->
        <div class="flex items-center gap-2.5 self-stretch md:self-center justify-center bg-white/90 border-2 border-[#4a3525] rounded-2xl px-4 py-2.5">
          <div class="text-center px-2.5 border-r-2 border-dashed border-[#DFD1BE]">
            <div class="text-[11px] font-bold text-[#7a5f4b]">圖鑑探索</div>
            <div class="text-lg font-black text-[#E76F51]" id="headerExploreCount">0 / 8</div>
          </div>
          <div class="text-center px-2.5">
            <div class="text-[11px] font-bold text-[#7a5f4b]">測驗最高分</div>
            <div class="text-lg font-black text-[#2A9D8F]" id="headerBestScore">-- 分</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 四大主要分頁導覽列 -->
    <nav class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3" aria-label="主導覽選單">
      <button onclick="switchTab('home')" id="tab-home" class="nav-tab active py-3 px-3 flex items-center justify-center gap-2 font-black text-sm sm:text-base">
        <span>🗺️</span><span>學習地圖</span>
      </button>
      <button onclick="switchTab('lesson7')" id="tab-lesson7" class="nav-tab py-3 px-3 flex items-center justify-center gap-2 font-black text-sm sm:text-base">
        <span>🏰</span><span>第7課 魔法建築</span>
      </button>
      <button onclick="switchTab('lesson8')" id="tab-lesson8" class="nav-tab py-3 px-3 flex items-center justify-center gap-2 font-black text-sm sm:text-base">
        <span>🍱</span><span>第8課 家鄉味</span>
      </button>
      <button onclick="switchTab('quiz')" id="tab-quiz" class="nav-tab py-3 px-3 flex items-center justify-center gap-2 font-black text-sm sm:text-base">
        <span>📝</span><span>線上測驗 (25題)</span>
      </button>
    </nav>
  </header>

  <!-- 主內容區 -->
  <main class="max-w-5xl mx-auto px-4 mt-4">

    <!-- ==================== 分頁 1：🗺️ 學習地圖 ==================== -->
    <section id="section-home" class="fade-in space-y-6">
      <div class="sketch-card bg-white p-5 sm:p-7">
        <div class="washi-tape washi-yellow"></div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-black flex items-center gap-2">
              <span>🎒</span> 歡迎來到〈用心看世界〉自主學習手帳！
            </h2>
            <p class="text-sm sm:text-base text-[#7a5f4b] mt-1.5 leading-relaxed">
              這學期我們要透過不同視角認識世界文化！先到西班牙欣賞高第充滿生命力的魔法建築，再去日本、印度、義大利與韓國品嘗各國家鄉味。看完圖鑑、玩完修辭小遊戲，就來挑戰 <strong>25 題完整版自我測驗</strong>，把成績單一鍵複製貼到 Google Classroom 繳交吧！
            </p>
          </div>
          <button onclick="quickStartQuiz('all')" class="sketch-btn bg-[#FFD6E0] px-5 py-3.5 text-base shrink-0">
            🚀 開始 25 題總測驗
          </button>
        </div>

        <!-- 學習進度追蹤卡片 -->
        <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-3.5">
          <div class="md:col-span-2 bg-[#FFFDF6] border-2 border-[#4a3525] rounded-2xl p-4">
            <div class="flex items-center justify-between text-sm font-black mb-2">
              <span>🌟 圖鑑卡片探索進度（第7、8課共 8 張）</span>
              <span id="homeProgressText" class="text-[#E76F51]">0% (0/8)</span>
            </div>
            <div class="w-full h-5 bg-[#F3ECE1] border-2 border-[#4a3525] rounded-full overflow-hidden">
              <div id="homeProgressBar" class="h-full bg-gradient-to-r from-[#FFD166] via-[#FF9EB5] to-[#80ED99] transition-all duration-500" style="width: 0%"></div>
            </div>
            <p class="text-xs font-bold text-[#7a5f4b] mt-2">💡 點開第7課「建築魔法圖鑑」與第8課「世界美食護照」即可自動記錄進度！</p>
          </div>
          <div class="bg-[#D8F3DC]/60 border-2 border-[#4a3525] rounded-2xl p-4 flex flex-col justify-center items-center text-center">
            <div class="text-xs font-black text-[#7a5f4b]">🏆 我的測驗最高紀錄</div>
            <div class="text-3xl font-black text-[#2A9D8F] my-1" id="homeBestScoreBig">尚未挑戰</div>
            <div class="text-xs font-bold text-[#4a3525]">自動儲存於本機瀏覽器</div>
          </div>
        </div>
      </div>

      <!-- 兩課總覽卡片 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 第 7 課總覽 -->
        <div class="sketch-card sketch-card-hover bg-[#D0EBFF]/45 p-6 flex flex-col justify-between">
          <div class="washi-tape washi-sky"></div>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 rounded-full bg-white border-2 border-[#4a3525] text-xs font-black">第7課・記敘文本</span>
              <span class="text-xs font-bold text-[#7a5f4b]">作者：嚴淑女</span>
            </div>
            <h3 class="text-2xl font-black mb-2">🏰 高第的魔法建築</h3>
            <div class="bg-white/90 border-2 border-[#4a3525] rounded-2xl p-3.5 text-sm leading-relaxed space-y-2 mb-4">
              <p><strong class="text-[#1D6FA3]">📖 課文大意：</strong>參觀西班牙巴塞隆納的米拉之家、巴特羅之家、奎爾公園與聖家堂，感受高第融入大自然曲線與奇思妙想的建築魅力。</p>
              <p><strong class="text-[#E76F51]">✨ 學習焦點：</strong>譬喻修辭辨識、「登」字形近字、建築四字語詞、習作延伸閱讀（光之教堂、蘭陽博物館）。</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2.5">
            <button onclick="switchTab('lesson7')" class="sketch-btn bg-[#FFF3B0] flex-1 py-3 px-4 text-sm sm:text-base">
              🔍 進入第7課教室
            </button>
            <button onclick="quickStartQuiz('l7')" class="sketch-btn bg-white py-3 px-4 text-sm sm:text-base">
              📝 專攻測驗 (13題)
            </button>
          </div>
        </div>

        <!-- 第 8 課總覽 -->
        <div class="sketch-card sketch-card-hover bg-[#FFE5CC]/55 p-6 flex flex-col justify-between">
          <div class="washi-tape washi-pink"></div>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 rounded-full bg-white border-2 border-[#4a3525] text-xs font-black">第8課・童詩</span>
              <span class="text-xs font-bold text-[#7a5f4b]">作者：王宗仁</span>
            </div>
            <h3 class="text-2xl font-black mb-2">🍱 嘗嘗我的家鄉味</h3>
            <div class="bg-white/90 border-2 border-[#4a3525] rounded-2xl p-3.5 text-sm leading-relaxed space-y-2 mb-4">
              <p><strong class="text-[#C85A17]">📖 課文大意：</strong>以「來，讓我用家鄉味招待你」串聯，用生動的聯想介紹日本壽司、印度咖哩和麥餅、義大利披薩與韓國辛奇。</p>
              <p><strong class="text-[#2A9D8F]">✨ 學習焦點：</strong>疊字修辭與節奏感、擬人法賞析、習作〈美味大挑戰〉猜謎詩、〈臺灣好滋味〉童詩創作。</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2.5">
            <button onclick="switchTab('lesson8')" class="sketch-btn bg-[#D8F3DC] flex-1 py-3 px-4 text-sm sm:text-base">
              🍽️ 進入第8課教室
            </button>
            <button onclick="quickStartQuiz('l8')" class="sketch-btn bg-white py-3 px-4 text-sm sm:text-base">
              📝 專攻測驗 (12題)
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 分頁 2：🏰 第7課互動教室 ==================== -->
    <section id="section-lesson7" class="hidden fade-in space-y-7">
      <div class="sketch-card bg-[#D0EBFF]/55 p-5 sm:p-6">
        <div class="washi-tape washi-sky"></div>
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <span class="px-3 py-1 rounded-full bg-white border-2 border-[#4a3525] text-xs font-black">第7課・記敘文本・西班牙巴塞隆納</span>
          <span class="text-sm font-bold text-[#7a5f4b]">作者：嚴淑女</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black">🏰 高第的魔法建築</h2>
        <p class="text-sm sm:text-base mt-2 leading-relaxed">
          從小喜歡觀察大自然的高第，把樹木、花草、貝殼、海浪和昆蟲翅膀的曲線放進建築物當中，讓<span class="hl-redup">圓弧流動的線條</span>成為他作品的特色，給了建築物神奇的生命力！
        </p>
      </div>

      <!-- 建築魔法圖鑑（4 張可點擊展開手繪卡片） -->
      <div>
        <h3 class="text-xl font-black mb-3 flex items-center gap-2"><span>✨</span> 建築魔法圖鑑（點擊卡片展開外觀特色、作者聯想與課文金句！）</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="l7-gallery"></div>
      </div>

      <!-- 互動小遊戲區 -->
      <div class="sketch-card bg-[#FFFDF6] p-5 sm:p-6 space-y-6">
        <div class="washi-tape washi-yellow"></div>
        <h3 class="text-xl sm:text-2xl font-black flex items-center gap-2"><span>🎮</span> 第7課互動練功房</h3>

        <!-- 互動小遊戲 A：譬喻偵探社 -->
        <div class="bg-[#FFF3B0]/60 border-2 border-[#4a3525] rounded-2xl p-4 sm:p-5">
          <h4 class="text-lg font-black mb-1.5">🕵️ 互動小遊戲 A【譬喻偵探社】</h4>
          <p class="text-sm sm:text-base leading-relaxed mb-3">
            找出兩種<strong>不同事物之間的相似點</strong>，用「如、像、有如、好似、宛如、彷彿」打比方，才是譬喻修辭喔！小心習作裡的「長相相似」陷阱題！
          </p>
          <div class="space-y-3" id="metaphorQuizContainer"></div>
        </div>

        <!-- 互動小遊戲 B：「登」字家族形近字 -->
