        <div class="washi-tape washi-yellow"></div>
        <h3 class="text-xl sm:text-2xl font-black flex items-center gap-2"><span>🎵</span> 第8課童詩魔法與寫作加油站</h3>

        <!-- 互動小遊戲 A：疊字節奏比一比 -->
        <div class="bg-[#FFF3B0]/60 border-2 border-[#4a3525] rounded-2xl p-4 sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <h4 class="text-lg font-black">🥁 互動小遊戲 A【疊字節奏比一比】</h4>
            <div class="flex gap-2">
              <button onclick="setRedupMode('plain')" id="btn-redup-plain" class="sketch-btn bg-white px-3.5 py-1.5 text-sm">無疊字句子</button>
              <button onclick="setRedupMode('redup')" id="btn-redup-redup" class="sketch-btn bg-[#FFD6E0] px-3.5 py-1.5 text-sm">✨ 有疊字句子</button>
            </div>
