    // =========================================================================
    // 4. 狀態管理與 LocalStorage
    // =========================================================================
    const STORAGE_KEY = 'g5_u3_l7l8_quiz25_state_v1';
    let appState = {
      exploredIds: [],
      bestScore: null,
      student: { className: '', seatNum: '', name: '' }
    };

    // 測驗狀態
    let quizScope = 'all'; // 'all' (25) | 'l7' (13) | 'l8' (12)
    let activeQuestions = [];
    let userAnswers = [];
    let currentQIndex = 0;
    let isCurrentAnswered = false;
    let quizStartTime = null;
    let timerInterval = null;
    let lastResult = null;

    // 形近字互動狀態
    let selectedDengChar = null;
    const dengAnswers = ['澄', '瞪', '燈'];

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          appState = {
            exploredIds: Array.isArray(parsed.exploredIds) ? parsed.exploredIds : [],
            bestScore: typeof parsed.bestScore === 'number' ? parsed.bestScore : null,
            student: parsed.student || { className: '', seatNum: '', name: '' }
          };
        }
      } catch (e) {
        console.warn('無法讀取 localStorage', e);
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.warn('無法寫入 localStorage', e);
      }
    }

    // =========================================================================
    // 5. 通用 UI 工具：Toast、分頁切換、進度條更新
    // =========================================================================
    let toastTimer = null;
    function showToast(msg, icon = '✨', bgColor = '#FFF3B0') {
      const toast = document.getElementById('toast');
      const inner = document.getElementById('toastInner');
      document.getElementById('toastIcon').textContent = icon;
      document.getElementById('toastMsg').textContent = msg;
      inner.style.backgroundColor = bgColor;
      toast.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    function switchTab(tabName) {
      ['home', 'lesson7', 'lesson8', 'quiz'].forEach(t => {
        document.getElementById(`section-${t}`).classList.toggle('hidden', t !== tabName);
        document.getElementById(`tab-${t}`).classList.toggle('active', t === tabName);
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function quickStartQuiz(scope) {
      switchTab('quiz');
      if (document.getElementById('quiz-stage-setup').classList.contains('hidden')) {
        resetToQuizSetup();
      }
      selectQuizScope(scope);
    }

    function updateProgressUI() {
      const count = appState.exploredIds.length;
      const pct = Math.round((count / 8) * 100);
      document.getElementById('headerExploreCount').textContent = `${count} / 8`;
      document.getElementById('headerBestScore').textContent = appState.bestScore !== null ? `${appState.bestScore} 分` : '-- 分';
      document.getElementById('homeProgressText').textContent = `${pct}% (${count}/8)`;
      document.getElementById('homeProgressBar').style.width = `${pct}%`;
      document.getElementById('homeBestScoreBig').textContent = appState.bestScore !== null ? `${appState.bestScore} 分` : '尚未挑戰';
    }

    function markExplored(cardId) {
      if (!appState.exploredIds.includes(cardId)) {
        appState.exploredIds.push(cardId);
        saveState();
        updateProgressUI();
        showToast(`太棒了！成功解鎖圖鑑卡片（${appState.exploredIds.length}/8）`, '🌟', '#D8F3DC');
      }
    }

    // =========================================================================
    // 6. 第 7 課互動教室渲染與小遊戲邏輯
    // =========================================================================
    function renderLesson7() {
      const gallery = document.getElementById('l7-gallery');
      gallery.innerHTML = L7_BUILDINGS.map(b => {
        const explored = appState.exploredIds.includes(b.id);
        return `
          <div class="sketch-card sketch-card-hover ${b.bg} p-4 sm:p-5 flex flex-col">
            <div class="mb-3">${b.svg}</div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <div>
                <h4 class="text-xl font-black">${b.name}</h4>
                <p class="text-xs font-bold text-[#7a5f4b]">${b.subtitle}</p>
              </div>
              <span id="badge-${b.id}" class="px-2.5 py-1 rounded-full text-xs font-black border-2 border-[#4a3525] ${explored ? 'bg-[#80ED99]' : 'bg-white'}">
                ${explored ? '✅ 已探索' : '🔍 點擊展開'}
              </span>
            </div>
            <button onclick="toggleCardDetail('${b.id}')" class="sketch-btn bg-white w-full py-2.5 px-3 text-sm mt-1">
              🪄 查看外觀特色、聯想與金句
            </button>
            <div id="detail-${b.id}" class="hidden mt-3 bg-white border-2 border-[#4a3525] rounded-2xl p-3.5 text-sm space-y-2 fade-in">
              <div><strong class="text-[#1D6FA3]">🏛️ 外觀特色：</strong>${b.feature}</div>
              <div>
                <div class="font-black text-[#E76F51] mb-1">✨ 作者的魔法聯想：</div>
                <ul class="list-disc pl-5 space-y-1 font-medium">
                  ${b.metaphors.map(m => `<li>${m}</li>`).join('')}
                </ul>
              </div>
              <div class="bg-[#FFF3B0]/65 rounded-xl p-2.5 text-xs sm:text-sm font-bold">
                💬 課文金句：${b.quote}
              </div>
            </div>
          </div>
        `;
      }).join('');

      // 譬喻偵探社
      const mBox = document.getElementById('metaphorQuizContainer');
      mBox.innerHTML = METAPHOR_QUESTIONS.map((item, idx) => `
        <div class="bg-white border-2 border-[#4a3525] rounded-2xl p-3.5">
          <div class="font-bold text-sm sm:text-base mb-2.5">${item.text}</div>
          <div class="flex flex-wrap gap-2">
            <button onclick="checkMetaphor(${idx}, true)" class="sketch-btn bg-[#D8F3DC] px-4 py-1.5 text-sm">⭕ 是譬喻</button>
            <button onclick="checkMetaphor(${idx}, false)" class="sketch-btn bg-[#FFD6E0] px-4 py-1.5 text-sm">❌ 不是譬喻</button>
          </div>
          <div id="meta-fb-${idx}" class="hidden mt-2.5 p-2.5 rounded-xl border-2 border-[#4a3525] text-sm font-bold"></div>
        </div>
      `).join('');
    }

    function toggleCardDetail(id) {
      const el = document.getElementById(`detail-${id}`);
      const isHidden = el.classList.contains('hidden');
      el.classList.toggle('hidden');
      if (isHidden) {
        markExplored(id);
        const badge = document.getElementById(`badge-${id}`);
        if (badge) {
          badge.textContent = id.startsWith('f-') ? '✅ 已集章' : '✅ 已探索';
          badge.classList.remove('bg-white');
          badge.classList.add('bg-[#80ED99]');
        }
      }
    }

    function checkMetaphor(idx, choice) {
      const q = METAPHOR_QUESTIONS[idx];
      const fb = document.getElementById(`meta-fb-${idx}`);
      const isRight = (choice === q.isMetaphor);
      fb.classList.remove('hidden', 'bg-[#D8F3DC]', 'bg-[#FFD6E0]');
      fb.classList.add(isRight ? 'bg-[#D8F3DC]' : 'bg-[#FFD6E0]');
      fb.innerHTML = isRight ? `🎉 偵探破案成功！${q.reason}` : `💡 再仔細想想喔！${q.reason}`;
    }

    // 「登」字家族形近字
    function selectDengChar(char) {
      selectedDengChar = char;
      document.querySelectorAll('.deng-chip').forEach(btn => {
        btn.classList.toggle('bg-[#FFF3B0]', btn.dataset.char === char);
        btn.classList.toggle('bg-white', btn.dataset.char !== char);
      });
    }

    function fillDengBlank(idx) {
      if (!selectedDengChar) {
        showToast('請先點選上方「澄、瞪、燈」其中一個字卡喔！', '👆');
        return;
      }
      const btn = document.getElementById(`deng-blank-${idx}`);
      const fb = document.getElementById(`deng-fb-${idx}`);
      btn.textContent = selectedDengChar;
      if (selectedDengChar === dengAnswers[idx]) {
        btn.className = 'min-w-[44px] h-9 px-2 border-2 border-[#4a3525] rounded-lg bg-[#D8F3DC] font-black text-[#2A9D8F]';
        fb.textContent = '✅ 答對了！';
        fb.className = 'text-xs font-black text-[#2A9D8F] ml-auto';
      } else {
        btn.className = 'min-w-[44px] h-9 px-2 border-2 border-[#4a3525] rounded-lg bg-[#FFD6E0] font-black text-[#E63946]';
        fb.textContent = '❌ 再試試看別的字！';
        fb.className = 'text-xs font-black text-[#E63946] ml-auto';
      }
    }

    function resetDengQuiz() {
      selectedDengChar = null;
      document.querySelectorAll('.deng-chip').forEach(btn => {
        btn.classList.remove('bg-[#FFF3B0]');
        btn.classList.add('bg-white');
      });
      for (let i = 0; i < 3; i++) {
        const b = document.getElementById(`deng-blank-${i}`);
        b.textContent = '？';
        b.className = 'min-w-[44px] h-9 px-2 border-2 border-dashed border-[#4a3525] rounded-lg bg-[#FFFDF6] font-black text-[#1D6FA3] hover:bg-[#FFF3B0]';
        document.getElementById(`deng-fb-${i}`).textContent = '';
      }
    }

    function showIdiomDetail(word) {
      const info = IDIOM_DICT[word];
      if (!info) return;
      document.getElementById('idiomDetailBox').innerHTML = `
        <div class="fade-in text-[#4a3525]">
          <div class="text-base sm:text-lg font-black text-[#9B5DE5] mb-1">📖 ${word}</div>
          <p class="mb-1"><strong>意思：</strong>${info.meaning}</p>
          <p class="text-[#7a5f4b] bg-[#FFFDF6] p-2 rounded-xl border border-[#DFD1BE]"><strong>例句：</strong>${info.example}</p>
        </div>
      `;
    }

    function checkIdiomMini(num, isRight) {
      const fb = document.getElementById(`idiom-mini-fb-${num}`);
      fb.classList.remove('hidden', 'text-[#2A9D8F]', 'text-[#E63946]');
      if (isRight) {
        fb.classList.add('text-[#2A9D8F]');
        fb.textContent = num === 1
          ? '✅ 答對了！「搖搖欲墜」形容大樓搖晃得快要倒塌，非常危險。'
          : '✅ 答對了！「富麗堂皇」形容宮殿絢爛美麗、氣勢宏偉。';
      } else {
        fb.classList.add('text-[#E63946]');
        fb.textContent = '❌ 意思不太一樣喔！再看看句子的情境提示試一次！';
      }
    }

    // =========================================================================
    // 7. 第 8 課互動教室渲染與小遊戲邏輯
    // =========================================================================
    function renderLesson8() {
      const gallery = document.getElementById('l8-gallery');
      gallery.innerHTML = L8_FOODS.map(f => {
        const explored = appState.exploredIds.includes(f.id);
        return `
          <div class="sketch-card sketch-card-hover ${f.bg} p-4 sm:p-5 flex flex-col">
            <div class="mb-3">${f.svg}</div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <div>
                <div class="text-xs font-black text-[#7a5f4b]">${f.country}</div>
                <h4 class="text-xl font-black">${f.name}</h4>
              </div>
              <span id="badge-${f.id}" class="px-2.5 py-1 rounded-full text-xs font-black border-2 border-[#4a3525] ${explored ? 'bg-[#80ED99]' : 'bg-white'}">
                ${explored ? '✅ 已集章' : '🍽️ 點擊品嘗'}
              </span>
            </div>
            <button onclick="toggleCardDetail('${f.id}')" class="sketch-btn bg-white w-full py-2.5 px-3 text-sm mt-1">
              📖 讀童詩精選句與文化知識
            </button>
            <div id="detail-${f.id}" class="hidden mt-3 bg-white border-2 border-[#4a3525] rounded-2xl p-3.5 text-sm space-y-2.5 fade-in">
              <div class="bg-[#FFFDF6] border-2 border-dashed border-[#DFD1BE] rounded-xl p-3 font-bold leading-relaxed">
                🎵 <strong>童詩精選句：</strong><br/>${f.poem}
              </div>
              <div class="space-y-1.5">
                ${f.decode.map(d => `<p class="leading-relaxed">${d}</p>`).join('')}
              </div>
              <div class="bg-[#D8F3DC]/65 rounded-xl p-2.5 text-xs font-bold">
                🌍 飲食文化小知識：${f.culture}
              </div>
            </div>
          </div>
        `;
      }).join('');

      setRedupMode('redup');
    }

    function setRedupMode(mode) {
      const btnPlain = document.getElementById('btn-redup-plain');
      const btnRedup = document.getElementById('btn-redup-redup');
      const box = document.getElementById('redupCompareBox');

      if (mode === 'plain') {
        btnPlain.classList.add('bg-[#FFD6E0]'); btnPlain.classList.remove('bg-white');
        btnRedup.classList.add('bg-white'); btnRedup.classList.remove('bg-[#FFD6E0]');
        box.innerHTML = `
          <div class="bg-white border-2 border-[#4a3525] rounded-2xl p-4 fade-in">
            <div class="text-xs font-black text-[#7a5f4b] mb-1">例句 1（印度咖哩）</div>
            <p class="text-base font-bold">洗一場 <u>熱的</u> <u>濃稠的</u> 香料澡</p>
          </div>
          <div class="bg-white border-2 border-[#4a3525] rounded-2xl p-4 fade-in">
            <div class="text-xs font-black text-[#7a5f4b] mb-1">例句 2（韓國辛奇）</div>
            <p class="text-base font-bold">先和鹽巴來個暖身操／<u>拉筋</u>、<u>出汗</u></p>
          </div>
        `;
      } else {
        btnRedup.classList.add('bg-[#FFD6E0]'); btnRedup.classList.remove('bg-white');
        btnPlain.classList.add('bg-white'); btnPlain.classList.remove('bg-[#FFD6E0]');
        box.innerHTML = `
          <div class="bg-white border-2 border-[#4a3525] rounded-2xl p-4 fade-in">
            <div class="text-xs font-black text-[#E76F51] mb-1">✨ 例句 1（加入疊字更生動！）</div>
            <p class="text-base font-bold">洗一場 <span class="hl-redup">熱熱的</span> <span class="hl-person">濃濃稠稠的</span> 香料澡</p>
          </div>
          <div class="bg-white border-2 border-[#4a3525] rounded-2xl p-4 fade-in">
            <div class="text-xs font-black text-[#2A9D8F] mb-1">✨ 例句 2（加入疊字更有節奏！）</div>
            <p class="text-base font-bold">先和鹽巴來個暖身操／<span class="hl-redup">拉拉</span>筋、<span class="hl-mint">出出</span>汗</p>
          </div>
        `;
      }
    }

    function guessRiddle(num, choice) {
      const fb = document.getElementById(`riddle-fb-${num}`);
      const correct = num === 1 ? '番茄' : '香蕉';
      const explain = num === 1
        ? '答對了！是「番茄」🍅！果實像紅柿且傳自西洋，營養豐富，可以做成番茄醬或煮湯。'
        : '答對了！是「香蕉」🍌！黃色防晒衣是香蕉皮，棕色細長帽子是蒂頭，脫掉防晒衣就是剝皮！';

      fb.classList.remove('hidden', 'bg-[#D8F3DC]', 'bg-[#FFD6E0]');
      if (choice === correct) {
        fb.classList.add('bg-[#D8F3DC]');
        fb.textContent = `🎉 ${explain}`;
      } else {
        fb.classList.add('bg-[#FFD6E0]');
        fb.textContent = `🤔 不是「${choice}」喔！再從詩裡的顏色、外型與吃法線索猜猜看！`;
      }
    }

    // =========================================================================
    // 8. 線上自我測驗系統（25題完整版，即答即評 + Google Classroom 成績單）
    // =========================================================================
    function syncSetupInputsFromState() {
      document.getElementById('setupClass').value = appState.student.className || '';
      document.getElementById('setupSeat').value = appState.student.seatNum || '';
      document.getElementById('setupName').value = appState.student.name || '';
    }

    function saveStudentInfoFromSetup() {
      appState.student.className = document.getElementById('setupClass').value.trim();
      appState.student.seatNum = document.getElementById('setupSeat').value.trim();
      appState.student.name = document.getElementById('setupName').value.trim();
      saveState();
    }

    function selectQuizScope(scope) {
      quizScope = scope;
      ['all', 'l7', 'l8'].forEach(s => {
        const btn = document.getElementById(`scope-${s}`);
        btn.classList.toggle('bg-[#FFD6E0]', s === scope);
        btn.classList.toggle('bg-white', s !== scope);
      });
    }

    function getScopeTitle(scope) {
      if (scope === 'l7') return '第7課專攻測驗（13題）';
      if (scope === 'l8') return '第8課專攻測驗（12題）';
      return '綜合總測驗（完整25題）';
    }

    function startQuiz() {
      saveStudentInfoFromSetup();
      const { className, seatNum, name } = appState.student;
      if (!className || !seatNum || !name) {
        const box = document.getElementById('setupStudentBox');
        box.classList.remove('shake-wrong');
        void box.offsetWidth;
        box.classList.add('shake-wrong');
        showToast('溫柔提醒：請先填寫「班級、座號、姓名」再開始測驗喔！', '✏️', '#FFD6E0');
        return;
      }

      // 依模式取得題目
      if (quizScope === 'l7') {
        activeQuestions = FULL_QUESTION_BANK.filter(q => q.lesson === 'l7');
      } else if (quizScope === 'l8') {
        activeQuestions = FULL_QUESTION_BANK.filter(q => q.lesson === 'l8');
      } else {
        activeQuestions = [...FULL_QUESTION_BANK];
      }

      userAnswers = new Array(activeQuestions.length).fill(null);
      currentQIndex = 0;
      isCurrentAnswered = false;
      quizStartTime = Date.now();

      // 切換至作答畫面
      document.getElementById('quiz-stage-setup').classList.add('hidden');
      document.getElementById('quiz-stage-result').classList.add('hidden');
      document.getElementById('quiz-stage-playing').classList.remove('hidden');

      document.getElementById('playScopeLabel').textContent = getScopeTitle(quizScope);
      document.getElementById('playStudentLabel').textContent = `${className} ${seatNum}號 ${name}`;
      document.getElementById('playTotalNum').textContent = activeQuestions.length;

      clearInterval(timerInterval);
      updateTimerDisplay();
      timerInterval = setInterval(updateTimerDisplay, 1000);

      renderQuestion();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateTimerDisplay() {
      const sec = Math.floor((Date.now() - quizStartTime) / 1000);
      const m = String(Math.floor(sec / 60)).padStart(2, '0');
      const s = String(sec % 60).padStart(2, '0');
      document.getElementById('playTimer').textContent = `${m}:${s}`;
    }

    function renderQuestion() {
      const q = activeQuestions[currentQIndex];
      const total = activeQuestions.length;
      const letters = ['A', 'B', 'C', 'D'];
      isCurrentAnswered = false;

      document.getElementById('playCurrentNum').textContent = currentQIndex + 1;
      document.getElementById('playProgressBar').style.width = `${((currentQIndex + 1) / total) * 100}%`;
      document.getElementById('questionTag').textContent = q.tag;
      document.getElementById('questionBadge').textContent = `第 ${currentQIndex + 1} 題`;
      document.getElementById('questionText').textContent = `${currentQIndex + 1}. ${q.q}`;

      // 隱藏解析與下一題按鈕
      const fbBox = document.getElementById('instantFeedbackBox');
      fbBox.classList.add('hidden');
      fbBox.classList.remove('bg-[#D8F3DC]', 'bg-[#FFD6E0]');

      const nextBtn = document.getElementById('btnNextStep');
      nextBtn.classList.add('hidden');

      const optBox = document.getElementById('optionsContainer');
      optBox.innerHTML = q.options.map((opt, idx) => `
        <button onclick="handleSelectOption(${idx})" id="opt-btn-${idx}" class="sketch-btn w-full text-left p-3.5 sm:p-4 bg-white hover:bg-[#FFFDF6] flex items-center gap-3 text-sm sm:text-base">
          <span id="opt-badge-${idx}" class="w-8 h-8 rounded-full border-2 border-[#4a3525] bg-[#FFFDF6] flex items-center justify-center shrink-0 font-black">${letters[idx]}</span>
          <span class="leading-snug">${opt}</span>
        </button>
      `).join('');
    }

    // 選答後即時顯示對錯動畫與白話解析
    function handleSelectOption(optIdx) {
      if (isCurrentAnswered) return;
      isCurrentAnswered = true;
      userAnswers[currentQIndex] = optIdx;

      const q = activeQuestions[currentQIndex];
      const isCorrect = (optIdx === q.answer);
      const letters = ['A', 'B', 'C', 'D'];

      // 鎖定所有選項並標示對錯顏色
      q.options.forEach((_, idx) => {
        const btn = document.getElementById(`opt-btn-${idx}`);
        const badge = document.getElementById(`opt-badge-${idx}`);
        btn.disabled = true;

        if (idx === q.answer) {
          btn.classList.remove('bg-white', 'hover:bg-[#FFFDF6]');
          btn.classList.add('bg-[#D8F3DC]');
          badge.classList.remove('bg-[#FFFDF6]');
          badge.classList.add('bg-[#80ED99]');
          if (isCorrect) btn.classList.add('pop-correct');
        } else if (idx === optIdx && !isCorrect) {
          btn.classList.remove('bg-white', 'hover:bg-[#FFFDF6]');
          btn.classList.add('bg-[#FFD6E0]', 'shake-wrong');
          badge.classList.remove('bg-[#FFFDF6]');
          badge.classList.add('bg-[#FF8FA3]');
        } else {
          btn.classList.add('opacity-55');
        }
      });

      // 顯示即時解析框
      const fbBox = document.getElementById('instantFeedbackBox');
      const fbTitle = document.getElementById('instantFeedbackTitle');
      const fbExplain = document.getElementById('instantFeedbackExplain');

      fbBox.classList.remove('hidden');
      if (isCorrect) {
        fbBox.classList.add('bg-[#D8F3DC]');
        fbTitle.textContent = '🎉 答對了！好厲害！';
        fbTitle.className = 'text-base sm:text-lg font-black mb-1 text-[#2A9D8F]';
      } else {
        fbBox.classList.add('bg-[#FFD6E0]');
        fbTitle.textContent = `💡 差一點點！正確答案是 (${letters[q.answer]}) ${q.options[q.answer]}`;
        fbTitle.className = 'text-base sm:text-lg font-black mb-1 text-[#E63946]';
      }
      fbExplain.innerHTML = `<strong>📖 解析：</strong>${q.explain}`;

      // 顯示「下一題」或「交卷看成績」
      const nextBtn = document.getElementById('btnNextStep');
      const isLast = (currentQIndex === activeQuestions.length - 1);
      nextBtn.classList.remove('hidden', 'bg-[#FFF3B0]', 'bg-[#80ED99]');
      if (isLast) {
        nextBtn.classList.add('bg-[#80ED99]');
        nextBtn.textContent = '🏆 交卷看成績';
      } else {
        nextBtn.classList.add('bg-[#FFF3B0]');
        nextBtn.textContent = '下一題 ➡️';
      }
    }

    function goNextOrFinish() {
      if (currentQIndex < activeQuestions.length - 1) {
        currentQIndex++;
        renderQuestion();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        finishQuiz();
      }
    }

    function formatDateTime(date) {
      const y = date.getFullYear();
      const m = String(date.getMonth() + 1).padStart(2, '0');
      const d = String(date.getDate()).padStart(2, '0');
      const hh = String(date.getHours()).padStart(2, '0');
      const mm = String(date.getMinutes()).padStart(2, '0');
      const ss = String(date.getSeconds()).padStart(2, '0');
      return `${y}/${m}/${d} ${hh}:${mm}:${ss}`;
    }

    function finishQuiz() {
      clearInterval(timerInterval);
      const finishDate = new Date();
      const elapsedSec = Math.max(1, Math.floor((Date.now() - quizStartTime) / 1000));
      const durMin = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
      const durSec = String(elapsedSec % 60).padStart(2, '0');
      const durationStr = `${durMin}分${durSec}秒`;
      const finishTimeStr = formatDateTime(finishDate);

      let correctCount = 0;
      const wrongItems = [];
      const wrongNums = [];

      activeQuestions.forEach((q, idx) => {
        if (userAnswers[idx] === q.answer) {
          correctCount++;
        } else {
          wrongNums.push(idx + 1);
          wrongItems.push({ q, seqNum: idx + 1, userAns: userAnswers[idx] });
        }
      });

      const total = activeQuestions.length;
      const score = Math.round((correctCount / total) * 100);
      const accuracy = Math.round((correctCount / total) * 100);

      // 更新最高分
      if (appState.bestScore === null || score > appState.bestScore) {
        appState.bestScore = score;
        saveState();
        updateProgressUI();
      }

      lastResult = {
        scopeTitle: getScopeTitle(quizScope),
        score,
        correctCount,
        total,
        accuracy,
        wrongNums,
        durationStr,
        finishTimeStr
      };

      // 切換至結算畫面
      document.getElementById('quiz-stage-playing').classList.add('hidden');
      document.getElementById('quiz-stage-result').classList.remove('hidden');

      let title = '繼續加油！把錯題看懂就會大進步！💪';
      if (score === 100) title = '滿分 100 分！你是世界探索滿分大師！🏆';
      else if (score >= 90) title = '太棒了！你是用心看世界的小達人！🌟';
      else if (score >= 80) title = '表現很優秀！再複習一下錯題就能滿分囉！👏';
      else if (score >= 60) title = '不錯喔！看看錯題解析會更厲害！✨';

      document.getElementById('resultEncourageTitle').textContent = title;
      document.getElementById('resultScoreNum').textContent = score;
      document.getElementById('resultCorrectRatio').textContent = `${correctCount} / ${total} 題`;
      document.getElementById('resultAccuracy').textContent = `${accuracy}%`;
      document.getElementById('resultDuration').textContent = durationStr;
      document.getElementById('resultFinishTime').textContent = finishTimeStr;

      // 填入結算畫面學生資料（雙向同步）
      document.getElementById('resultClass').value = appState.student.className;
      document.getElementById('resultSeat').value = appState.student.seatNum;
      document.getElementById('resultName').value = appState.student.name;

      // 重設複製按鈕樣式
      const copyBtn = document.getElementById('btnCopyReport');
      copyBtn.classList.remove('bg-[#80ED99]');
      copyBtn.classList.add('bg-[#FFD166]');
      document.getElementById('btnCopyReportLabel').textContent = '一鍵複製成績單文字';

      updateReportPreviewText();
      renderWrongList(wrongItems);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 結算畫面修改學生資料 -> 雙向同步到準備畫面、localStorage 與成績單文字
    function syncResultStudentInfo() {
      appState.student.className = document.getElementById('resultClass').value.trim();
      appState.student.seatNum = document.getElementById('resultSeat').value.trim();
      appState.student.name = document.getElementById('resultName').value.trim();
      saveState();
      syncSetupInputsFromState();
      updateReportPreviewText();
    }

    function updateReportPreviewText() {
      if (!lastResult) return;
      const cls = appState.student.className || '（未填班級）';
      const seat = appState.student.seatNum || '（未填座號）';
      const name = appState.student.name || '（未填姓名）';

      const wrongText = lastResult.wrongNums.length === 0
        ? '無（全部答對！🎉）'
        : `第 ${lastResult.wrongNums.join('、')} 題`;

      const report = [
        '【115上 國語五上 第7、8課 線上自我測驗成績單】',
        `測驗模式：${lastResult.scopeTitle}`,
        `班級：${cls}｜座號：${seat}｜姓名：${name}`,
        `測驗成績：${lastResult.score} 分 / 100 分（答對 ${lastResult.correctCount} / ${lastResult.total} 題，正確率 ${lastResult.accuracy}%）`,
        `錯題題號：${wrongText}`,
        `作答耗時：${lastResult.durationStr}`,
        `完成時間：${lastResult.finishTimeStr}`
      ].join('\n');

      document.getElementById('reportPreview').value = report;
    }

    // 一鍵複製成績單文字（含 execCommand 可靠 fallback，相容所有瀏覽器與 iframe）
    function copyReportText() {
      const textarea = document.getElementById('reportPreview');
      const text = textarea.value;

      const onSuccess = () => {
        const btn = document.getElementById('btnCopyReport');
        btn.classList.remove('bg-[#FFD166]');
        btn.classList.add('bg-[#80ED99]');
        document.getElementById('btnCopyReportLabel').textContent = '✅ 已複製！請直接貼到 Google Classroom 繳交作業';
        showToast('✅ 已複製！請直接貼到 Google Classroom 繳交作業', '🎉', '#D8F3DC');
      };

      const fallbackCopy = () => {
        try {
          textarea.focus();
          textarea.select();
          textarea.setSelectionRange(0, 99999);
          const ok = document.execCommand('copy');
          if (ok) {
            onSuccess();
          } else {
            showToast('請手動全選上方成績單文字並按 Ctrl+C 複製喔！', '💡', '#FFD6E0');
          }
        } catch (err) {
          showToast('請手動全選上方成績單文字並按 Ctrl+C 複製喔！', '💡', '#FFD6E0');
        }
      };

      // 先嘗試 execCommand（在 iframe 中最穩定），若失敗再嘗試 navigator.clipboard
      try {
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, 99999);
        if (document.execCommand('copy')) {
          onSuccess();
          return;
        }
      } catch (e) {
        // 忽略並改用 clipboard API
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(onSuccess).catch(fallbackCopy);
      } else {
        fallbackCopy();
      }
    }

    function renderWrongList(wrongItems) {
      const badge = document.getElementById('wrongSummaryBadge');
      const container = document.getElementById('wrongListContainer');
      const letters = ['A', 'B', 'C', 'D'];

      badge.textContent = `共 ${wrongItems.length} 題錯題`;

      if (wrongItems.length === 0) {
        badge.classList.remove('bg-[#FFD6E0]');
        badge.classList.add('bg-[#D8F3DC]');
        container.innerHTML = `
          <div class="text-center py-8 bg-[#D8F3DC]/45 border-2 border-dashed border-[#4a3525] rounded-2xl font-black text-lg">
            🎉 太強了！本次測驗完全沒有錯題，給你一個大大的讚！
          </div>
        `;
        return;
      }

      badge.classList.remove('bg-[#D8F3DC]');
      badge.classList.add('bg-[#FFD6E0]');

      container.innerHTML = wrongItems.map(({ q, seqNum, userAns }) => `
        <div class="border-2 border-[#4a3525] rounded-2xl p-4 bg-[#FFD6E0]/30">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-white border border-[#4a3525]">${q.tag}</span>
            <span class="text-xs font-black text-[#E63946]">❌ 第 ${seqNum} 題</span>
          </div>
          <div class="font-black text-base mb-2">${seqNum}. ${q.q}</div>
          <div class="text-sm space-y-1 mb-2.5">
            <div>
              <strong>你的答案：</strong>
              <span class="font-bold text-[#E63946]">
                ${userAns !== null ? `(${letters[userAns]}) ${q.options[userAns]}` : '（未作答）'}
              </span>
            </div>
            <div>
              <strong>正確答案：</strong>
              <span class="font-black text-[#2A9D8F]">(${letters[q.answer]}) ${q.options[q.answer]}</span>
            </div>
          </div>
          <div class="bg-white border border-[#DFD1BE] rounded-xl p-2.5 text-xs sm:text-sm text-[#7a5f4b] leading-relaxed">
            <strong class="text-[#4a3525]">💡 白話解析：</strong>${q.explain}
          </div>
        </div>
      `).join('');
    }

    function resetToQuizSetup() {
      clearInterval(timerInterval);
      document.getElementById('quiz-stage-playing').classList.add('hidden');
      document.getElementById('quiz-stage-result').classList.add('hidden');
      document.getElementById('quiz-stage-setup').classList.remove('hidden');
      syncSetupInputsFromState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // =========================================================================
    // 9. 初始化應用程式
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      updateProgressUI();
      syncSetupInputsFromState();
      renderLesson7();
      renderLesson8();
    });
  </script>
</body>
</html>
